---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
    <div class="container-fluid px-4 px-lg-5">
        <div class="footer-main">
            <!-- Brand -->
            <div class="footer-brand">
                <a
                    href="/"
                    class="footer-logo-link"
                    aria-label="Black Criss - Inicio"
                >
                    <img
                        src="/images/branding/black-criss-tech-house-header-logo-white.svg"
                        alt="Black Criss"
                        class="footer-logo"
                    />
                </a>

                <p>
                    Tech House con raíces afro, identidad del Pacífico
                    colombiano y una visión que conecta música, cultura y
                    movimiento.
                </p>

                <div class="footer-social">
                    <a
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                        class="footer-social-link"
                    >
                        <img
                            src="/images/social/instagram.svg"
                            alt="Instagram"
                        />
                    </a>

                    <a
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="SoundCloud"
                        class="footer-social-link"
                    >
                        <img
                            src="/images/social/soundcloud.svg"
                            alt="SoundCloud"
                        />
                    </a>

                    <a
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="YouTube"
                        class="footer-social-link"
                    >
                        <img src="/images/social/youtube.svg" alt="YouTube" />
                    </a>
                </div>
            </div>

            <!-- Booking -->
            <div class="footer-booking">
                <span class="footer-label"> BOOKING </span>

                <h2>
                    LLEVEMOS EL RITMO<br />
                    A TU PRÓXIMO EVENTO.
                </h2>

                <a
                    href="https://www.gigg.me/blackcriss"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn footer-booking-btn"
                >
                    BOOK BLACK CRISS
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>

        <!-- Bottom -->
        <div class="footer-bottom">
            <p>
                © {currentYear} Black Criss. Todos los derechos reservados.
            </p>

            <a href="/"> BLACKCRISS.COM </a>
        </div>
    </div>
</footer>
