---
import "../impactAreas/impactAreas.css";
---

<section class="impact-areas">
    <div class="container-fluid px-4 px-lg-5">
        <!-- Header -->
        <div class="impact-areas-header">
            <span>ÁREAS DE ACCIÓN</span>

            <h2>
                CONVERTIR EL APOYO<br />
                EN ACCIONES CONCRETAS.
            </h2>

            <p>
                Black Criss Impact concentra sus esfuerzos en iniciativas que
                puedan generar bienestar, oportunidades y respuestas reales para
                comunidades del Chocó.
            </p>
        </div>

        <!-- Areas -->
        <div class="row g-3 g-lg-4">
            <!-- Area 01 -->
            <div class="col-12 col-md-6 col-xl-3">
                <article class="impact-area-card">
                    <div class="impact-area-number">01</div>

                    <div class="impact-area-content">
                        <h3>RESPUESTA</h3>

                        <p>
                            Apoyo ante emergencias y situaciones que afecten
                            directamente a comunidades del Chocó.
                        </p>
                    </div>
                </article>
            </div>

            <!-- Area 02 -->
            <div class="col-12 col-md-6 col-xl-3">
                <article class="impact-area-card">
                    <div class="impact-area-number">02</div>

                    <div class="impact-area-content">
                        <h3>EDUCACIÓN</h3>

                        <p>
                            Acciones que contribuyan a ampliar oportunidades
                            para niños, jóvenes y comunidades del territorio.
                        </p>
                    </div>
                </article>
            </div>

            <!-- Area 03 -->
            <div class="col-12 col-md-6 col-xl-3">
                <article class="impact-area-card">
                    <div class="impact-area-number">03</div>

                    <div class="impact-area-content">
                        <h3>COMUNIDAD</h3>

                        <p>
                            Iniciativas orientadas al bienestar, la colaboración
                            y el fortalecimiento de las comunidades.
                        </p>
                    </div>
                </article>
            </div>

            <!-- Area 04 -->
            <div class="col-12 col-md-6 col-xl-3">
                <article class="impact-area-card">
                    <div class="impact-area-number">04</div>

                    <div class="impact-area-content">
                        <h3>VIVIENDA</h3>

                        <p>
                            Apoyo a acciones que contribuyan a mejorar
                            condiciones habitacionales de familias del Chocó.
                        </p>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>
