---
import "../404/404.css";
---

<section class="error-page" aria-labelledby="error-page-title">
    <div class="container-fluid px-4 px-lg-5">
        <div class="error-page-content">
            <span class="error-page-label">ERROR</span>

            <h1 id="error-page-title" class="error-page-title">404</h1>

            <p class="error-page-description">
                Parece que este beat se salió de la pista. La página que buscas
                no existe o cambió de lugar.
            </p>

            <a href="/" class="btn error-page-btn">
                <span>VOLVER AL INICIO</span>
                <span aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</section>
