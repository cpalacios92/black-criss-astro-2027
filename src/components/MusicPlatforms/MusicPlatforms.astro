---
import "../MusicPlatforms/musicPlatforms.css";
---

<section class="music-platforms">
    <div class="container-fluid px-4 px-lg-5">
        <div class="music-platforms-grid">
            <a
                href="https://www.beatport.com/es/artist/black-criss/136507"
                target="_blank"
                rel="noopener noreferrer"
                class="music-platform-card"
                aria-label="Black Criss en Beatport"
            >
                <img
                    src="/images/platforms/beatport.svg"
                    alt=""
                    width="30"
                    height="30"
                />

                <span class="music-platform-name">BEATPORT</span>

                <span class="music-platform-arrow" aria-hidden="true"> → </span>
            </a>

            <a
                href="https://open.spotify.com/intl-es/artist/2d3g8OYlYBUdrR35hcxgbK?si=0nj8ohOgRlCr6adIXvyF6g"
                target="_blank"
                rel="noopener noreferrer"
                class="music-platform-card"
                aria-label="Black Criss en Spotify"
            >
                <img
                    src="/images/platforms/spotify.svg"
                    alt=""
                    width="30"
                    height="30"
                />

                <span class="music-platform-name">SPOTIFY</span>

                <span class="music-platform-arrow" aria-hidden="true"> → </span>
            </a>

            <a
                href="https://soundcloud.com/blackcriss"
                target="_blank"
                rel="noopener noreferrer"
                class="music-platform-card"
                aria-label="Black Criss en SoundCloud"
            >
                <img
                    src="/images/platforms/soundcloud.svg"
                    alt=""
                    width="30"
                    height="30"
                />

                <span class="music-platform-name">SOUNDCLOUD</span>

                <span class="music-platform-arrow" aria-hidden="true"> → </span>
            </a>

            <a
                href="https://www.youtube.com/@blackcriss"
                target="_blank"
                rel="noopener noreferrer"
                class="music-platform-card"
                aria-label="Black Criss en YouTube"
            >
                <img
                    src="/images/platforms/youtube.svg"
                    alt=""
                    width="30"
                    height="30"
                />

                <span class="music-platform-name">YOUTUBE</span>

                <span class="music-platform-arrow" aria-hidden="true"> → </span>
            </a>
        </div>
    </div>
</section>
