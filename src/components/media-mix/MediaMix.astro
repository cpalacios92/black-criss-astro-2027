---
import "../media-mix/media-mix.css";
---

<section class="media-mix-section">
    <div class="container-fluid px-4 px-lg-5">
        <!-- Header -->
        <div class="media-mix-header">
            <h2>MEDIA</h2>
        </div>

        <!-- Filters -->
        <div
            class="media-mix-filters"
            role="group"
            aria-label="Filtrar contenido multimedia"
        >
            <button
                type="button"
                class="media-filter active"
                data-filter="all"
                aria-pressed="true"
            >
                TODO
            </button>

            <button
                type="button"
                class="media-filter"
                data-filter="image"
                aria-pressed="false"
            >
                FOTOS
            </button>

            <button
                type="button"
                class="media-filter"
                data-filter="video"
                aria-pressed="false"
            >
                VIDEOS
            </button>
        </div>

        <!-- Media grid -->
        <div class="media-mix-grid">
            <!-- IMAGE 01 -->
            <figure class="media-mix-item media-item-large" data-media="image">
                <img
                    src="/images/media/black-criss-tech-house-dj-music-4.webp"
                    alt="Black Criss"
                    loading="lazy"
                    decoding="async"
                />
            </figure>

            <!-- IMAGE 02 -->
            <figure class="media-mix-item media-item-medium" data-media="image">
                <img
                    src="/images/media/black-criss-tech-house-dj-music-2.webp"
                    alt="Black Criss"
                    loading="lazy"
                    decoding="async"
                />
            </figure>

            <!-- VIDEO 01 -->
            <div class="media-mix-item media-item-tall" data-media="video">
                <div class="media-video">
                    <iframe
                        src="https://www.youtube-nocookie.com/embed/gtX1b1-Oyok?si=37prilj6n83ysDEn"
                        title="Black Criss"
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen></iframe>
                </div>
            </div>

            <!-- IMAGE 03 -->
            <figure class="media-mix-item media-item-small" data-media="image">
                <img
                    src="/images/media/black-criss-tech-house-dj-music-1.webp"
                    alt="Black Criss"
                    loading="lazy"
                    decoding="async"
                />
            </figure>

            <!-- VIDEO 02 -->
            <div class="media-mix-item media-item-medium" data-media="video">
                <div class="media-video">
                    <iframe
                        src="https://www.youtube-nocookie.com/embed/v_4A1CukVqA?si=ummNOpF15_8BfFjq"
                        title="Black Criss"
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen></iframe>
                </div>
            </div>

            <!-- IMAGE 04 -->
            <figure class="media-mix-item media-item-medium" data-media="image">
                <img
                    src="/images/media/black-criss-tech-house-dj-music-3.webp"
                    alt="Black Criss"
                    loading="lazy"
                    decoding="async"
                />
            </figure>
        </div>
    </div>
</section>

<script>
    const mediaSection =
        document.querySelector<HTMLElement>(".media-mix-section");

    if (mediaSection) {
        const filters =
            mediaSection.querySelectorAll<HTMLButtonElement>(".media-filter");

        const items =
            mediaSection.querySelectorAll<HTMLElement>(".media-mix-item");

        filters.forEach((button) => {
            button.addEventListener("click", () => {
                const filter = button.dataset.filter ?? "all";

                filters.forEach((item) => {
                    const isActive = item === button;

                    item.classList.toggle("active", isActive);

                    item.setAttribute("aria-pressed", String(isActive));
                });

                items.forEach((item) => {
                    const type = item.dataset.media;

                    const shouldHide = filter !== "all" && type !== filter;

                    item.classList.toggle("is-hidden", shouldHide);
                });
            });
        });
    }
</script>
