---

<section class="releases-section" id="music">
    <div class="container-fluid px-4 px-lg-5">
        <div class="releases-header">
            <span class="releases-header-label">
                Explora la música de Black Criss: EPs & singles
            </span>

            <h2>LANZAMIENTOS</h2>
        </div>

        <!-- Releases -->
        <div class="releases-scroll" data-releases-scroll>
            {
                releases.map((release) => (
                    <article class="release-card">
                        <img
                            src={release.image}
                            alt={release.name}
                            class="release-card-artwork"
                            loading="lazy"
                            decoding="async"
                        />

                        <div class="release-card-content">
                            <h3>{release.name}</h3>
                            <div class="release-card-meta">
                                <span>{release.type}</span>
                                <span>{release.artist}</span>
                                <span>{release.year}</span>
                            </div>

                            <div class="release-card-platforms">
                                {[
                                    { name: "Beatport", href: release.beatport, icon: "beatport" },
                                    { name: "Spotify", href: release.spotify, icon: "spotify" },
                                    { name: "Apple Music", href: release.appleMusic, icon: "apple-music" },
                                    { name: "YouTube Music", href: release.youtubeMusic, icon: "youtube-music" },
                                ].map((platform) => (
                                    <a
                                        href={platform.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label={`${release.name} en ${platform.name}`}
                                    >
                                        <img src={`/images/platforms/${platform.icon}.svg`} alt="" />
                                    </a>
                                ))}
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>

        <!-- Navigation -->
        <div
            class="releases-navigation"
            aria-label="Navegación de lanzamientos"
        >
            <button
                class="releases-nav-btn"
                type="button"
                data-releases-prev
                aria-label="Ver lanzamientos anteriores"
            >
                <span aria-hidden="true">←</span>
            </button>

            <button
                class="releases-nav-btn"
                type="button"
                data-releases-next
                aria-label="Ver más lanzamientos"
            >
                <span aria-hidden="true">→</span>
            </button>
        </div>

        <!-- CTA -->
        <div class="releases-cta">
            <a
                href="https://www.beatport.com/es/artist/black-criss/136507"
                target="_blank"
                rel="noopener noreferrer"
                class="btn releases-btn"
            >
                VER MÁS LANZAMIENTOS
                <span aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</section>

<script>
    const releasesScroll = document.querySelector<HTMLElement>(
        "[data-releases-scroll]",
    );

    const previousButton = document.querySelector<HTMLButtonElement>(
        "[data-releases-prev]",
    );

    const nextButton = document.querySelector<HTMLButtonElement>(
        "[data-releases-next]",
    );

    if (releasesScroll && previousButton && nextButton) {
        const getScrollAmount = () => {
            const card =
                releasesScroll.querySelector<HTMLElement>(".release-card");

            if (!card) return 320;

            const styles = window.getComputedStyle(releasesScroll);
            const gap = parseFloat(styles.columnGap || styles.gap) || 0;

            return card.offsetWidth + gap;
        };

        const updateNavigation = () => {
            const maxScroll =
                releasesScroll.scrollWidth - releasesScroll.clientWidth;

            previousButton.disabled = releasesScroll.scrollLeft <= 5;

            nextButton.disabled = releasesScroll.scrollLeft >= maxScroll - 5;
        };

        previousButton.addEventListener("click", () => {
            releasesScroll.scrollBy({
                left: -getScrollAmount(),
                behavior: "smooth",
            });
        });

        nextButton.addEventListener("click", () => {
            releasesScroll.scrollBy({
                left: getScrollAmount(),
                behavior: "smooth",
            });
        });

        releasesScroll.addEventListener("scroll", updateNavigation, {
            passive: true,
        });

        window.addEventListener("resize", updateNavigation);

        updateNavigation();
    }
</script>
