<script>
    const releasesScroll = document.querySelector<HTMLElement>(
        "[data-releases-scroll]",
    );

    const previousButton = document.querySelector<HTMLButtonElement>(
        "[data-releases-prev]",
    );

    const nextButton = document.querySelector<HTMLButtonElement>(
        "[data-releases-next]",
    );

    if (releasesScroll && previousButton && nextButton) {
        const getScrollAmount = () => {
            const card =
                releasesScroll.querySelector<HTMLElement>(".release-card");

            if (!card) return 320;

            const styles = window.getComputedStyle(releasesScroll);
            const gap = parseFloat(styles.columnGap || styles.gap) || 0;

            return card.offsetWidth + gap;
        };

        const updateNavigation = () => {
            const maxScroll =
                releasesScroll.scrollWidth - releasesScroll.clientWidth;

            previousButton.disabled = releasesScroll.scrollLeft <= 5;

            nextButton.disabled = releasesScroll.scrollLeft >= maxScroll - 5;
        };

        previousButton.addEventListener("click", () => {
            releasesScroll.scrollBy({
                left: -getScrollAmount(),
                behavior: "smooth",
            });
        });

        nextButton.addEventListener("click", () => {
            releasesScroll.scrollBy({
                left: getScrollAmount(),
                behavior: "smooth",
            });
        });

        releasesScroll.addEventListener("scroll", updateNavigation, {
            passive: true,
        });

        window.addEventListener("resize", updateNavigation);

        updateNavigation();
    }
</script>
