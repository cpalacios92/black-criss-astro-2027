        </div>
    </div>
</section>

<script>
    const showsSection = document.querySelector("[data-shows-section]");
    const showsWidget = document.querySelector("[data-shows-widget]");

    if (showsSection && showsWidget) {
        const checkEvents = () => {
            const events = showsWidget.querySelectorAll(".bit-event");

            if (events.length > 0) {
                showsSection.removeAttribute("hidden");
                return true;
            }

            return false;
        };

        if (!checkEvents()) {
            const observer = new MutationObserver(() => {
                if (checkEvents()) {
                    observer.disconnect();
                }
            });

            observer.observe(showsWidget, {
                childList: true,
                subtree: true,
            });

            setTimeout(() => {
                observer.disconnect();
            }, 10000);
        }
    }
</script>
