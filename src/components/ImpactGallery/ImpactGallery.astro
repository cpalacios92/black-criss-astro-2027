---
import "../impactGallery/impactGallery.css";
---

<section class="impact-gallery">
    <div class="container-fluid px-4 px-lg-5">
        <!-- Header -->
        <div class="impact-gallery-header">
            <span>EVIDENCIA</span>

            <h2>
                ESTO PASÓ GRACIAS<br />
                A QUIENES APORTARON.
            </h2>

            <p>
                Documentamos cada acción para mostrar cómo el apoyo de la
                comunidad se transforma en ayuda real para el Chocó.
            </p>
        </div>

        <!-- Gallery -->
        <div class="impact-gallery-grid">
            <figure class="impact-gallery-item impact-gallery-item-1">
                <img
                    src="/images/impact/black-criss-impact-choco-01.webp"
                    alt="Ayuda de Black Criss Impact en Chocó"
                    loading="lazy"
                />
            </figure>

            <figure class="impact-gallery-item impact-gallery-item-2">
                <img
                    src="/images/impact/black-criss-impact-choco-02.webp"
                    alt="Preparación de ayudas para comunidades del Chocó"
                    loading="lazy"
                />
            </figure>

            <figure class="impact-gallery-item impact-gallery-item-3">
                <img
                    src="/images/impact/black-criss-impact-choco-03.webp"
                    alt="Elementos reunidos por Black Criss Impact"
                    loading="lazy"
                />
            </figure>

            <figure class="impact-gallery-item impact-gallery-item-4">
                <img
                    src="/images/impact/black-criss-impact-choco-04.webp"
                    alt="Entrega de ayudas en Chocó"
                    loading="lazy"
                />
            </figure>

            <figure class="impact-gallery-item impact-gallery-item-5">
                <img
                    src="/images/impact/black-criss-impact-choco-05.webp"
                    alt="Acción comunitaria de Black Criss Impact"
                    loading="lazy"
                />
            </figure>

            <figure class="impact-gallery-item impact-gallery-item-6">
                <img
                    src="/images/impact/black-criss-impact-choco-06.webp"
                    alt="Resultados de Black Criss Impact en Chocó"
                    loading="lazy"
                />
            </figure>
        </div>
    </div>
</section>
