---
import "../latest-release/latest-release.css";
---

<section class="latest-release">
    <div class="container-fluid px-4 px-lg-5">
        <div class="latest-release-header">
            <span>ÚLTIMO LANZAMIENTO</span>
            <h2>THE NEGRITOS VOL. 2</h2>
        </div>

        <div class="latest-release-grid">
            <!-- Artwork -->
            <div class="latest-release-artwork">
                <img
                    src="/images/releases/black_criss_tech_house_gahva_quibdo_choco.webp"
                    alt="The Negritos Vol. 2 - Black Criss"
                    loading="lazy"
                    decoding="async"
                />
            </div>

            <!-- Information -->
            <div class="latest-release-content">
                <div class="latest-release-info">
                    <div class="release-info-row">
                        <span>LABEL</span>
                        <strong>Soundlection</strong>
                    </div>

                    <div class="release-info-row">
                        <span>RELEASED</span>
                        <strong>09.10.2026</strong>
                    </div>

                    <div class="release-info-row">
                        <span>GENRE</span>
                        <strong>Tech House</strong>
                    </div>
                </div>

                <!-- Platforms -->
                <div class="release-platforms">
                    <a
                        href="https://www.beatport.com/release/gahva/7501820"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Escuchar en Beatport"
                    >
                        <img
                            src="/images/platforms/beatport.svg"
                            alt="Beatport"
                        />
                    </a>

                    <a
                        href="https://open.spotify.com/album/37mKECWLzuhP1nycPut3GD?si=bX0GpAiwR7i1ymy1enESlQ"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Escuchar en Spotify"
                    >
                        <img
                            src="/images/platforms/spotify.svg"
                            alt="Spotify"
                        />
                    </a>

                    <a
                        href="https://music.apple.com/es/album/gahva-single/6814890244"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Escuchar en Apple Music"
                    >
                        <img
                            src="/images/platforms/apple-music.svg"
                            alt="Apple Music"
                        />
                    </a>

                    <a
                        href="https://tidal.com/album/563474466"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Escuchar en Tidal"
                    >
                        <img src="/images/platforms/tidal.svg" alt="Tidal" />
                    </a>

                    <a
                        href="https://music.youtube.com/playlist?list=OLAK5uy_mFDj_MpM_3Op-6f-qV6bhPASZNyHT6VRs"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Escuchar en YouTube Music"
                    >
                        <img
                            src="/images/platforms/youtube-music.svg"
                            alt="YouTube Music"
                        />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
