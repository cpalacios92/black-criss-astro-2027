---
import "../explore-sections/explore-sections.css";

const sections = [
    {
        title: "MÚSICA",
        link: "/music",
        buttonText: "EXPLORAR MÚSICA",
        image: "/images/explore/black-criss-music.png",
        alt: "Black Criss Música",
        className: "explore-card-music",
    },
    {
        title: "MERCH",
        link: "https://shop.blackcriss.com/",
        buttonText: "VER MERCH",
        image: "/images/explore/black-criss-merch-bcith.png",
        alt: "Black Criss Merch",
        className: "explore-card-merch",
        target: "_blank",
    },
    {
        title: "IN STUDIO",
        link: "https://instudio.blackcriss.com/",
        buttonText: "CONOCER IN STUDIO",
        image: "/images/explore/black-criss-in-studio.png",
        alt: "Black Criss In Studio",
        className: "explore-card-studio",
        target: "_blank",
    },
];
---

<section class="explore-sections">
    {
        sections.map((section) => (
            <article class={`explore-card ${section.className}`}>
                <div class="explore-card-visual">
                    <img
                        src={section.image}
                        width="800"
                        height="800"
                        alt={section.alt}
                        class="explore-card-image"
                        loading="lazy"
                        decoding="async"
                    />
                </div>

                <div class="explore-card-content">
                    <h2 class="explore-card-title">{section.title}</h2>

                    <a
                        href={section.link}
                        class="btn explore-card-btn"
                        target={section.target}
                        rel="noopener noreferrer"
                    >
                        {section.buttonText}
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>
        ))
    }
</section>
