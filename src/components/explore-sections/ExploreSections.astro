---
import "../explore-sections/explore-sections.css";
import { Image } from "astro:assets";
const currentYear = new Date().getFullYear();
---

<section class="explore-sections">
    <!-- MUSIC -->
    <article class="explore-card explore-card-music">
        <div class="explore-card-visual">
            <img
                src="/src/assets/explore/black-criss-music.png"
                width="800"
                height="800"
                alt="Black Criss Música"
                class="explore-card-image"
                loading="lazy"
                decoding="async"
            />
        </div>

        <div class="explore-card-content">
            <h2 class="explore-card-title">MÚSICA</h2>

            <a
                href="/music"
                class="btn explore-card-btn"
                rel="noopener noreferrer"
            >
                EXPLORAR MÚSICA
                <span aria-hidden="true">→</span>
            </a>
        </div>
    </article>

    <!-- MERCH -->
    <article class="explore-card explore-card-merch">
        <div class="explore-card-visual">
            <img
                src="/src/assets/explore/black-criss-merch-bcith.png"
                width="800"
                height="800"
                alt="Black Criss Merch"
                class="explore-card-image"
                loading="lazy"
                decoding="async"
            />
        </div>

        <div class="explore-card-content">
            <h2 class="explore-card-title">MERCH</h2>

            <a
                href="https://shop.blackcriss.com/"
                class="btn explore-card-btn"
                target="_blank"
                rel="noopener noreferrer"
            >
                VER MERCH
                <span aria-hidden="true">→</span>
            </a>
        </div>
    </article>

    <!-- IN STUDIO -->
    <article class="explore-card explore-card-studio">
        <div class="explore-card-visual">
            <img
                src="/src/assets/explore/black-criss-in-studio.png"
                width="800"
                height="800"
                alt="Black Criss In Studio"
                class="explore-card-image"
                loading="lazy"
                decoding="async"
            />
        </div>

        <div class="explore-card-content">
            <h2 class="explore-card-title">IN STUDIO</h2>

            <a
                href="https://instudio.blackcriss.com/"
                class="btn explore-card-btn"
                target="_blank"
                rel="noopener noreferrer"
            >
                CONOCER IN STUDIO
                <span aria-hidden="true">→</span>
            </a>
        </div>
    </article>
</section>
