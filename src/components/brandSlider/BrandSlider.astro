---
import BrandSlideCard from "./BrandSlideCard.astro";
import "../brandSlider/brand-slider.css";

const slides = [
    {
        name: "",
        text: "",
        image: "/images/slide/black_criss_tech_house_quibdo_choco_octava.png",
        mobileImage:
            "/images/slide/black_criss_tech_house_quibdo_choco_octava_mobile.png",
        link: "https://soundcloud.com/blackcriss/black-criss-octava-club-bogota",
        linkLabel: "ESCUCHAR EL SET",
    },
    {
        name: "GAHVA",
        text: "Nuevo lanzamiento de Black Criss × DJ Shakur.",
        image: "/images/slide/black_criss_tech_house_quibdo_choco_gahva.webp",
        mobileImage:
            "/images/slide/black_criss_tech_house_quibdo_choco_gahva_mobile.webp",
        link: "https://www.beatport.com/release/gahva/7501820",
        linkLabel: "ESCUCHAR GAHVA",
    },
    {
        name: "",
        text: "DJ y productor colombiano de música electrónica.",
        image: "/images/slide/black-criss-bcith-tech-house-quibdo-choco-2.webp",
        link: "/music",
        linkLabel: "ESCUCHAR AHORA",
    },
    {
        name: "",
        text: "Lleva la identidad Black Criss más allá de la música.",
        image: "/images/slide/black-criss-bcith-merch.webp",
        link: "https://shop.blackcriss.com/",
        linkLabel: "IR A LA TIENDA",
    },
];
---

<section
    id="brandSlider"
    class="brand-slider carousel slide"
    data-bs-ride="carousel"
    data-bs-interval="5000"
    aria-label="Universo Black Criss"
>
    <div class="carousel-inner">
        {
            slides.map((slide, index) => (
                <BrandSlideCard slide={slide} active={index === 0} />
            ))
        }
    </div>

    <button
        class="carousel-control-prev brand-slider-control"
        type="button"
        data-bs-target="#brandSlider"
        data-bs-slide="prev"
        aria-label="Slide anterior"
    >
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </button>

    <button
        class="carousel-control-next brand-slider-control"
        type="button"
        data-bs-target="#brandSlider"
        data-bs-slide="next"
        aria-label="Siguiente slide"
    >
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </button>
</section>
