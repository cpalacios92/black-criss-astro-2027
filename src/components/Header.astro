<header class="site-header position-absolute top-0 start-0 w-100">
    <div class="container-fluid header-container">
        <div
            class="header-inner d-flex align-items-center justify-content-between"
        >
            <!-- Logo -->
            <a href="/" class="header-brand" aria-label="Black Criss - Inicio">
                <img
                    src="/images/branding/black-criss-tech-house-header-logo-white.svg"
                    alt="Black Criss"
                    class="header-logo"
                />
            </a>

            <!-- Actions -->
            <div class="header-actions d-flex align-items-center">
                <a
                    href="https://open.spotify.com/artist/2d3g8OYlYBUdrR35hcxgbK"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn header-listen-btn"
                >
                    ESCUCHAR AHORA
                </a>

                <button
                    class="menu-trigger d-flex align-items-center"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#mainMenu"
                    aria-controls="mainMenu"
                    aria-label="Abrir menú"
                >
                    <span class="menu-icon" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </button>
            </div>
        </div>
    </div>
</header>

<!-- ==================================================
     OFFCANVAS MENU
================================================== -->

<div
    class="offcanvas offcanvas-end main-menu"
    tabindex="-1"
    id="mainMenu"
    aria-label="Menú principal"
>
    <div class="offcanvas-header header-container">
        <a
            href="/"
            aria-label="Black Criss - Inicio"
            data-bs-dismiss="offcanvas"
        >
            <img
                src="/images/branding/black-criss-tech-house-header-logo-white.svg"
                alt="Black Criss"
                class="menu-logo"
            />
        </a>

        <button
            type="button"
            class="btn-close btn-close-white shadow-none"
            data-bs-dismiss="offcanvas"
            aria-label="Cerrar menú"></button>
    </div>

    <div class="offcanvas-body header-container d-flex align-items-center">
        <nav class="menu-navigation" aria-label="Navegación principal">
            <!-- Página Black Criss -->
            <a href="/black-criss"> Black Criss </a>

            <!-- Secciones de Home -->
            <a href="/#music"> Música </a>

            <a href="/store"> Store </a>

            <!-- Sitio externo -->
            <a
                href="https://instudio.blackcriss.com/"
                target="_blank"
                rel="noopener noreferrer"
            >
                In Studio
            </a>

            <a href="/#impact"> Impact </a>

            <a href="/#contact"> Contacto </a>
        </nav>
    </div>
</div>
