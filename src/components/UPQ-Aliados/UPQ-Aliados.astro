---
import "./upq-aliados.css";

const aliados = [
    {
        nombre: "A Tu Lado Venezuela",
        logo: "/images/upq/logos/A_tu_lado_Venezuela.webp",
    },
    {
        nombre: "Triplepoint",
        logo: "/images/upq/logos/triplepoint.webp",
    },
    {
        nombre: "Vibra Positivo Fest",
        logo: "/images/upq/logos/vibra-positivo-fest.png",
    },
    {
        nombre: "Gigg.me",
        logo: "/images/upq/logos/GIGG.ME.png",
    },
    {
        nombre: "Miradores Medellín",
        logo: "/images/upq/logos/miradores.jpeg",
    },
    {
        nombre: "Bel Posto",
        logo: "/images/upq/logos/bel_posto.webp",
    },
];
---

<section class="upq-aliados" id="aliados">
    <div class="upq-aliados-container">
        <header class="upq-aliados-header">
            <h2>Nuestros aliados <span>y colaboradores</span></h2>
        </header>

        <ul class="upq-aliados-list">
            {
                aliados.map(({ nombre, logo }) => (
                    <li class="upq-aliado">
                        <img
                            src={logo}
                            alt={`Logo de ${nombre}`}
                            loading="lazy"
                        />
                    </li>
                ))
            }
        </ul>
    </div>
</section>
