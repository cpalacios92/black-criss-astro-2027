---
import "../sets-playlists/setsPlaylists.css";
---

<section class="music-sets">
    <div class="container-fluid px-4 px-lg-5">
        <div class="music-section-header">
            <h2>SETS & PLAYLISTS</h2>
        </div>

        <div class="music-sets-scroll" data-sets-scroll>
            <!-- SET 01 -->
            <article class="music-set-card">
                <img
                    src="/images/sets-playlists/black-criss-kore-music-soundcloud.webp"
                    alt="Black Criss DJ Set"
                />

                <div class="music-set-content">
                    <span>SOUNDCLOUD</span>

                    <h3>KORE MUSIC SESSIONS 008</h3>

                    <a
                        href="https://soundcloud.com/blackcriss/kore-music-sessions-008-black-criss-gruss"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        ESCUCHAR
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>

            <!-- SET 02 -->
            <article class="music-set-card">
                <img
                    src="/images/sets-playlists/black-criss-kore-music-spotify.webp"
                    alt="Black Criss Playlist"
                />

                <div class="music-set-content">
                    <span>SPOTIFY</span>

                    <h3>THIS IS BLACK CRISS</h3>

                    <a
                        href="https://open.spotify.com/playlist/6T2G3D1S1A6vpEMOjRURiq?si=z5ThfL1USoCHY_7TI-z94Q"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        ESCUCHAR
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>

            <!-- SET 03 -->
            <article class="music-set-card">
                <img
                    src="/images/sets-playlists/black-criss-tech-house-dj-music-4.webp"
                    alt="Black Criss Tech House"
                />

                <div class="music-set-content">
                    <span>SOUNDCLOUD</span>

                    <h3>IV ANIVERSARIO ATOPE</h3>

                    <a
                        href="https://soundcloud.com/atope-colombia/black-criss-gruss-iv-aniversario-atope-en-sonorama"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        ESCUCHAR
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>

            <!-- SET 04 -->
            <article class="music-set-card">
                <img
                    src="/images/sets-playlists/black-criss-kore-music-spotify-1.webp"
                    alt="Black Criss Live"
                />

                <div class="music-set-content">
                    <span>SPOTIFY</span>

                    <h3>BCITH PLAYLIST</h3>

                    <a
                        href="https://open.spotify.com/playlist/19M3cCaJQUBLCYj0ysGT1u?si=DFNrbbicQ56ml2D398XdYw"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        ESCUCHAR
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>
        </div>

        <!-- NAVIGATION -->
        <div
            class="music-sets-navigation"
            aria-label="Navegación de sets y playlists"
        >
            <button
                class="music-sets-nav-btn"
                type="button"
                data-sets-prev
                aria-label="Ver sets anteriores"
            >
                <span aria-hidden="true">←</span>
            </button>

            <button
                class="music-sets-nav-btn"
                type="button"
                data-sets-next
                aria-label="Ver más sets"
            >
                <span aria-hidden="true">→</span>
            </button>
        </div>
    </div>
</section>

<script>
    const setsScroll =
        document.querySelector<HTMLElement>("[data-sets-scroll]");

    const previousButton =
        document.querySelector<HTMLButtonElement>("[data-sets-prev]");

    const nextButton =
        document.querySelector<HTMLButtonElement>("[data-sets-next]");

    if (setsScroll && previousButton && nextButton) {
        const getScrollAmount = () => {
            const card =
                setsScroll.querySelector<HTMLElement>(".music-set-card");

            if (!card) return 380;

            const styles = window.getComputedStyle(setsScroll);
            const gap = parseFloat(styles.columnGap || styles.gap) || 0;

            return card.offsetWidth + gap;
        };

        const updateNavigation = () => {
            const maxScroll = setsScroll.scrollWidth - setsScroll.clientWidth;

            previousButton.disabled = setsScroll.scrollLeft <= 5;

            nextButton.disabled = setsScroll.scrollLeft >= maxScroll - 5;
        };

        previousButton.addEventListener("click", () => {
            setsScroll.scrollBy({
                left: -getScrollAmount(),
                behavior: "smooth",
            });
        });

        nextButton.addEventListener("click", () => {
            setsScroll.scrollBy({
                left: getScrollAmount(),
                behavior: "smooth",
            });
        });

        setsScroll.addEventListener("scroll", updateNavigation, {
            passive: true,
        });

        window.addEventListener("resize", updateNavigation);

        updateNavigation();
    }
</script>
