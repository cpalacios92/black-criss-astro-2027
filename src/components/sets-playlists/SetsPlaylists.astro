---
import "../sets-playlists/setsPlaylists.css";

const sets = [
    {
        image: "/images/sets-playlists/black_criss_tech_house_bcith_octava_quibdo_choco.webp",
        platform: "SOUNDCLOUD",
        name: "OCTAVA CLUB (BOGOTÁ - COLOMBIA)",
        link: "https://soundcloud.com/blackcriss/black-criss-octava-club-bogota",
        alt: "Black Criss DJ Set",
    },
    {
        image: "/images/sets-playlists/black-criss-kore-music-soundcloud.webp",
        platform: "SOUNDCLOUD",
        name: "KORE MUSIC SESSIONS 008",
        link: "https://soundcloud.com/blackcriss/kore-music-sessions-008-black-criss-gruss",
        alt: "Black Criss DJ Set",
    },
    {
        image: "/images/sets-playlists/black-criss-kore-music-spotify.webp",
        platform: "SPOTIFY",
        name: "THIS IS BLACK CRISS",
        link: "https://open.spotify.com/playlist/6T2G3D1S1A6vpEMOjRURiq?si=z5ThfL1USoCHY_7TI-z94Q",
        alt: "Black Criss Playlist",
    },
    {
        image: "/images/sets-playlists/black-criss-tech-house-dj-music-4.webp",
        platform: "SOUNDCLOUD",
        name: "IV ANIVERSARIO ATOPE",
        link: "https://soundcloud.com/atope-colombia/black-criss-gruss-iv-aniversario-atope-en-sonorama",
        alt: "Black Criss Tech House",
    },
    {
        image: "/images/sets-playlists/black-criss-kore-music-spotify-1.webp",
        platform: "SPOTIFY",
        name: "BCITH PLAYLIST",
        link: "https://open.spotify.com/playlist/19M3cCaJQUBLCYj0ysGT1u?si=DFNrbbicQ56ml2D398XdYw",
        alt: "Black Criss Live",
    },
];
---

<section class="music-sets">
    <div class="container-fluid px-4 px-lg-5">
        <div class="music-section-header">
            <h2>SETS & PLAYLISTS</h2>
        </div>

        <div class="music-sets-scroll" data-sets-scroll>
            {
                sets.map((set) => (
                    <a
                        class="music-set-card"
                        href={set.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${set.name} en ${set.platform}`}
                    >
                        <img
                            src={set.image}
                            alt={set.alt}
                            loading="lazy"
                            decoding="async"
                        />

                        <div class="music-set-content">
                            <span>{set.platform}</span>

                            <h3>{set.name}</h3>

                            <span class="music-set-listen">
                                {set.buttonText}
                                <span aria-hidden="true" />
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>

        <!-- NAVIGATION -->
        <div
            class="music-sets-navigation"
            aria-label="Navegación de sets y playlists"
        >
            <button
                class="music-sets-nav-btn"
                type="button"
                data-sets-prev
                aria-label="Ver sets anteriores"
            >
                <span aria-hidden="true">←</span>
            </button>

            <button
                class="music-sets-nav-btn"
                type="button"
                data-sets-next
                aria-label="Ver más sets"
            >
                <span aria-hidden="true">→</span>
            </button>
        </div>
    </div>
</section>

<script>
    const setsScroll =
        document.querySelector<HTMLElement>("[data-sets-scroll]");

    const previousButton =
        document.querySelector<HTMLButtonElement>("[data-sets-prev]");

    const nextButton =
        document.querySelector<HTMLButtonElement>("[data-sets-next]");

    if (setsScroll && previousButton && nextButton) {
        const getScrollAmount = () => {
            const card =
                setsScroll.querySelector<HTMLElement>(".music-set-card");

            if (!card) return 380;

            const styles = window.getComputedStyle(setsScroll);
            const gap = parseFloat(styles.columnGap || styles.gap) || 0;

            return card.offsetWidth + gap;
        };

        const updateNavigation = () => {
            const maxScroll = setsScroll.scrollWidth - setsScroll.clientWidth;

            previousButton.disabled = setsScroll.scrollLeft <= 5;

            nextButton.disabled = setsScroll.scrollLeft >= maxScroll - 5;
        };

        previousButton.addEventListener("click", () => {
            setsScroll.scrollBy({
                left: -getScrollAmount(),
                behavior: "smooth",
            });
        });

        nextButton.addEventListener("click", () => {
            setsScroll.scrollBy({
                left: getScrollAmount(),
                behavior: "smooth",
            });
        });

        setsScroll.addEventListener("scroll", updateNavigation, {
            passive: true,
        });

        window.addEventListener("resize", updateNavigation);

        updateNavigation();
    }
</script>
