<div class="floating-actions">
    <!-- Store -->
    <a href="#" class="floating-store" aria-label="Ir a la tienda">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L20 8H7"
            ></path>

            <circle cx="10" cy="20" r="1"></circle>
            <circle cx="18" cy="20" r="1"></circle>
        </svg>
    </a>

    <!-- Back to top -->
    <button
        id="backToTop"
        class="back-to-top"
        type="button"
        aria-label="Volver al inicio"
    >
        <span aria-hidden="true">↑</span>
    </button>
</div>

<script>
    const backToTop = document.getElementById("backToTop");
    const mainMenu = document.getElementById("mainMenu");

    if (backToTop) {
        const updateButton = () => {
            const menuIsOpen = mainMenu?.classList.contains("show");
            const hasScrolled = window.scrollY > 300;

            backToTop.classList.toggle(
                "is-visible",
                hasScrolled && !menuIsOpen,
            );
        };

        window.addEventListener("scroll", updateButton, {
            passive: true,
        });

        backToTop.addEventListener("click", () => {
            window.scrollTo({
                top: 0,
                behavior: "smooth",
            });
        });

        if (mainMenu) {
            mainMenu.addEventListener("show.bs.offcanvas", () => {
                backToTop.classList.remove("is-visible");
            });

            mainMenu.addEventListener("hidden.bs.offcanvas", () => {
                updateButton();
            });
        }

        updateButton();
    }
</script>
