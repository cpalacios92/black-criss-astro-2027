---
import Layout from "../layouts/Layout.astro";
import ArtistStory from "../components/artist-story/ArtistStory.astro";
import GalleryGrid from "../components/gallery-grid/GalleryGrid.astro";
import Videos from "../components/videos/Videos.astro";
---

<Layout title="Black Criss">
    <ArtistStory />

    <GalleryGrid />

    <Videos />

    <!-- BOOKING CTA -->
    <section class="artist-booking">
        <div class="container-fluid px-4 px-lg-5">
            <div class="artist-booking-content">
                <a
                    href="/music"
                    rel="noopener noreferrer"
                    class="btn artist-booking-btn"
                >
                    ESCUCHA AHORA
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </section>
</Layout>
