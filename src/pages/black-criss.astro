---
import Layout from "../layouts/Layout.astro";
import ArtistStory from "../components/ArtistStory.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import Videos from "../components/Videos.astro";
---

<Layout title="Black Criss">
    <ArtistStory />

    <GalleryGrid />

    <Videos />

    <!-- BOOKING CTA -->
    <section class="artist-booking">
        <div class="container-fluid px-4 px-lg-5">
            <div class="artist-booking-content">
                <span>BOOKING</span>

                <h2>LLEVEMOS EL RITMO A TU PRÓXIMO EVENTO</h2>

                <a
                    href="https://www.gigg.me/blackcriss"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn artist-booking-btn"
                >
                    BOOKING BLACK CRISS
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </section>
</Layout>
