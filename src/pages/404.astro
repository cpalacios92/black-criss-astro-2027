---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404">
    <section class="error-page">
        <div class="container-fluid px-4 px-lg-5">
            <div class="error-page-content">
                <span class="error-page-label"> ERROR </span>

                <h1>404</h1>

                <p>
                    Parece que este beat se salió de la pista. La página que
                    buscas no existe o cambió de lugar.
                </p>

                <a href="/" class="btn error-page-btn">
                    VOLVER AL INICIO
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </section>
</Layout>
